<?xml version="1.0" encoding="utf-8"?>
<!--
  HOREGDAW MSI (WiX Toolset v5: `dotnet tool install -g wix`). Built by package.ps1:

    wix build horegdaw.wxs -arch x64 -d Version=1.2.3 -d BinDir=... -d IconPath=... -o out.msi

  Per-machine install into Program Files, a Start Menu shortcut, `.scraft` sessions owned by
  HOREGDAW, and HOREGDAW offered under "Open with" for WAV/AIFF/FLAC/MP3 and MIDI files
  (without taking over the user's default player for them).
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package
      Name="HOREGDAW"
      Manufacturer="Learning Machines LLC"
      Version="$(var.Version)"
      UpgradeCode="EE53D3E5-D0AE-40F9-808D-9417FDEBF61A"
      Scope="perMachine"
      Compressed="yes"
      Language="1033">
    <SummaryInformation Description="HOREGDAW digital audio workstation" Manufacturer="Learning Machines LLC" />
    <!-- Same-version upgrades let successive pre-releases of one X.Y.Z replace each other
         (MSI versions are numeric, so 1.2.3-rc.1 and 1.2.3-rc.2 are both 1.2.3). -->
    <MajorUpgrade AllowSameVersionUpgrades="yes"
        DowngradeErrorMessage="A newer version of HOREGDAW is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <Icon Id="HoregdawIcon.ico" SourceFile="$(var.IconPath)" />
    <Property Id="ARPPRODUCTICON" Value="HoregdawIcon.ico" />
    <Property Id="ARPURLINFOABOUT" Value="https://getartcraft.com/apps/horegdaw" />
    <Property Id="ARPURLUPDATEINFO" Value="https://getartcraft.com/apps/horegdaw" />
    <Property Id="ARPHELPLINK" Value="https://discord.gg/artcraft" />

    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="INSTALLFOLDER" Name="HOREGDAW" />
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder" />

    <Feature Id="Main" Title="HOREGDAW" Level="1">
      <ComponentGroupRef Id="HoregdawFiles" />
    </Feature>
  </Package>

  <Fragment>
    <ComponentGroup Id="HoregdawFiles" Directory="INSTALLFOLDER">
      <Component Id="HoregdawApp" Guid="091136D7-205E-41A8-9D27-5E231F7CBBD4">
        <File Id="HoregdawExe" Source="$(var.BinDir)\horegdaw.exe" KeyPath="yes">
          <Shortcut Id="StartMenuShortcut" Directory="ProgramMenuFolder" Name="HOREGDAW"
              Description="HOREGDAW digital audio workstation" WorkingDirectory="INSTALLFOLDER" Advertise="yes"
              Icon="HoregdawIcon.ico" IconIndex="0" />
        </File>

        <!-- .scraft: HOREGDAW's own session format; HOREGDAW is its default app. -->
        <ProgId Id="Horegdaw.Session" Description="HOREGDAW Session" Icon="HoregdawExe" IconIndex="0">
          <Extension Id="scraft" ContentType="application/x-horegda-session">
            <Verb Id="open" Command="Open" TargetFile="HoregdawExe" Argument="&quot;%1&quot;" />
          </Extension>
        </ProgId>
        <!-- Audio and MIDI files: offered under "Open with" (imported into a session), never forced
             as the default. -->
        <ProgId Id="Horegdaw.Audio" Description="Audio File" Icon="HoregdawExe" IconIndex="0" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Horegdaw.Audio\shell\open\command" Value="&quot;[#HoregdawExe]&quot; &quot;%1&quot;" Type="string" />
        <ProgId Id="Horegdaw.Midi" Description="MIDI File" Icon="HoregdawExe" IconIndex="0" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Horegdaw.Midi\shell\open\command" Value="&quot;[#HoregdawExe]&quot; &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.wav\OpenWithProgids" Name="Horegdaw.Audio" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.aif\OpenWithProgids" Name="Horegdaw.Audio" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.aiff\OpenWithProgids" Name="Horegdaw.Audio" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.flac\OpenWithProgids" Name="Horegdaw.Audio" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.mp3\OpenWithProgids" Name="Horegdaw.Audio" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.mid\OpenWithProgids" Name="Horegdaw.Midi" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.midi\OpenWithProgids" Name="Horegdaw.Midi" Value="" Type="string" />

        <!-- "Open with" app list and the Run dialog (Win+R "horegdaw"). -->
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\horegdaw.exe" Name="FriendlyAppName" Value="HOREGDAW" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\horegdaw.exe\shell\open\command" Value="&quot;[#HoregdawExe]&quot; &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\horegdaw.exe\SupportedTypes" Name=".scraft" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\horegdaw.exe\SupportedTypes" Name=".wav" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\horegdaw.exe\SupportedTypes" Name=".aif" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\horegdaw.exe\SupportedTypes" Name=".aiff" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\horegdaw.exe\SupportedTypes" Name=".flac" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\horegdaw.exe\SupportedTypes" Name=".mp3" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\horegdaw.exe\SupportedTypes" Name=".mid" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\horegdaw.exe\SupportedTypes" Name=".midi" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Microsoft\Windows\CurrentVersion\App Paths\horegdaw.exe" Value="[#HoregdawExe]" Type="string" />
      </Component>

      <Component Id="HoregdawCli" Guid="4552049A-C2F0-4AB0-BAE6-A62C3348F4B4">
        <File Id="HoregdawCliExe" Source="$(var.BinDir)\horegdaw-cli.exe" KeyPath="yes" />
      </Component>
    </ComponentGroup>
  </Fragment>
</Wix>
